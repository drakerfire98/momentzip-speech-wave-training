{
  "version": 1,
  "commands": [
    {
      "id": "download_all_supported",
      "command": "python scripts/download_open_corpora.py --source speech_commands --source voxforge --voxforge-limit 50"
    },
    {
      "id": "extract_downloads",
      "command": "python scripts/extract_downloads.py"
    },
    {
      "id": "bootstrap_speech_commands",
      "command": "python scripts/bootstrap_training_repo.py --source-root downloads/extracted/speech_commands_v0.02"
    },
    {
      "id": "rebuild_three_layers",
      "command": "python scripts/build_word_shape_index.py --staged-root staged --artifacts-root artifacts"
    },
    {
      "id": "build_proto_phoneme_and_invariant_banks",
      "command": "python scripts/build_proto_phoneme_bank.py --staged-root staged --artifacts-root artifacts"
    },
    {
      "id": "build_voxforge_transition_bank",
      "command": "python scripts/build_transition_bank.py --voxforge-root downloads/voxforge --artifacts-root artifacts"
    }
  ]
}
